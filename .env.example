# Copie para .env na raiz. Gere SESSION_SECRET: py -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-this-to-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql+psycopg://repolens:repolens@db:5432/repolens
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
# demo: resultado determinístico de um repositório fictício; live: GitHub + agentes reais
ANALYSIS_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Deve coincidir com a URL de callback do OAuth App do GitHub
GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback
ALLOW_DEMO_LOGIN=true
COOKIE_SECURE=false
MAX_FILES=60
MAX_SOURCE_BYTES=300000
MAX_TOOL_STEPS=10
MAX_OUTPUT_TOKENS=2000
